# ---------------------------------------------------------------
# Copia este archivo a .env y rellena los valores.
# En Vercel: Project Settings > Environment Variables.
# Las NEXT_PUBLIC_* se exponen al navegador; el resto NO.
# ---------------------------------------------------------------

# --- Sanity (CMS) ---
# projectId 'xhpb5q5u' y dataset 'production' estan fijados en lib/sanity_client.js
# Token de lectura: sanity.io/manage > API > Tokens
SANITY_PUBLIC_TOKEN=

# --- Stripe (pagos) ---
# dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxx
NEXT_SECRET_STRIPE_KEY=sk_test_xxx

# --- Supabase (pedidos) ---
# supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gmail (emails de confirmacion y de estado) ---
# GMAIL_PASS es una "contrasena de aplicacion", no la del correo:
# myaccount.google.com/apppasswords
GMAIL_USER=trufaateca@gmail.com
GMAIL_PASS=

# --- Pushover (aviso de pedido nuevo al movil) ---
# pushover.net
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- URL publica del sitio ---
# Local: http://localhost:3000
# Produccion: https://tu-dominio.vercel.app  (sin barra final)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
